/*
 * DS18B20 Pin Finder for Arduino Nano
 * Slow version - easy to read
 */

#include <OneWire.h>
#include <DallasTemperature.h>

int foundPin = -1;

void testPin(int pin) {
    OneWire ow(pin);
    DallasTemperature sensor(&ow);
    sensor.begin();
    
    if (sensor.getDeviceCount() > 0) {
        sensor.requestTemperatures();
        delay(850);
        float temp = sensor.getTempCByIndex(0);
        foundPin = pin;
        Serial.println("====================");
        Serial.print("FOUND ON PIN: ");
        Serial.println(pin);
        Serial.print("Temperature: ");
        Serial.print(temp);
        Serial.println(" C");
        Serial.println("====================");
    }
}

void setup() {
    Serial.begin(9600);
    delay(2000);
    Serial.println("=== Scanning for DS18B20 ===");
    Serial.println("Testing pins 2 to 12...");
    Serial.println();
    
    for (int pin = 2; pin <= 12; pin++) {
        Serial.print("Testing pin ");
        Serial.print(pin);
        Serial.println("...");
        delay(500);
        testPin(pin);
        delay(500);
    }
    
    if (foundPin == -1) {
        Serial.println("NO SENSOR FOUND ON ANY PIN");
        Serial.println("Check wiring");
    } else {
        Serial.print("USE PIN: ");
        Serial.println(foundPin);
    }
}

void loop() {
    // Do nothing - results shown once in setup
}
